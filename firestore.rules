rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every document the app uses lives under its owner's tree:
    //   users/{uid}                      profile (createdAt/email/displayName)
    //   users/{uid}/bits/{id}            bits
    //   users/{uid}/setLists/{id}        set lists (ordered)
    //   users/{uid}/recordings/{id}      recordings (audio in Storage, user-scoped there)
    // Nothing else is readable or writable by a client.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
